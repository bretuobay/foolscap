{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "exclude": ["src/**/*.test.ts", "src/test-setup.ts", "src/test-helpers.ts", "vitest.config.ts"],
  "angularCompilerOptions": {
