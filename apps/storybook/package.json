{
  "name": "@foolscap/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "HOME=/tmp STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --port 6006 --no-open",
    "build:storybook": "HOME=/tmp STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "serve:storybook": "node scripts/serve-static-storybook.mjs",
    "test:storybook": "start-server-and-test \"pnpm serve:storybook\" http://127.0.0.1:6006 \"test-storybook --config-dir .storybook --url http://127.0.0.1:6006\"",
    "test:e2e": "playwright test --config ../../playwright.config.ts",
    "test:visual": "playwright test --config ../../playwright.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@web-loom/foolscap-css": "workspace:*",
    "@web-loom/foolscap-react": "workspace:*",
    "@web-loom/foolscap-tokens": "workspace:*"
  },
  "devDependencies": {
    "@foolscap/eslint-config": "workspace:*",
    "@foolscap/tsconfig": "workspace:*",
    "@axe-core/playwright": "^4.9.0",
    "@playwright/test": "^1.45.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test-runner": "^0.22.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.18.0",
    "playwright": "^1.45.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "start-server-and-test": "^2.0.0",
    "storybook": "^8.6.18",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
